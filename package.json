{
  "name": "@bifravst/sim-details",
  "version": "0.0.0-development",
  "description": "Provides usage information about SIM cards that have been shipped with Nordic Semiconductor development kits.",
  "type": "module",
  "scripts": {
    "test": "find ./ -type f -name \\*.spec.ts -not -path './e2e-tests/*' -not -path './node_modules/*' -not -path './dist/*' | xargs node --experimental-transform-types --test --test-reporter spec",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test:e2e": "node --experimental-transform-types --test e2e-tests/**.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/sim-details.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/sim-details/issues"
  },
  "keywords": [],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-acm": "3.1118.0",
    "@aws-sdk/client-iam": "3.1118.0",
    "@aws-sdk/client-route-53": "3.1118.0",
    "@aws-sdk/client-sqs": "3.1118.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@bifravst/aws-cdk-lambda-helpers": "5.0.5",
    "@bifravst/ci": "3.0.1",
    "@bifravst/cloudformation-helpers": "10.0.1",
    "@bifravst/eslint-config-typescript": "8.0.2",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/aws-lambda": "8.10.162",
    "@types/cfn-response": "1.0.9",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk-lib": "2.265.0",
    "cdk": "2.1139.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nock": "14.0.17",
    "tsmatchers": "6.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@aws-lambda-powertools/metrics": "2.35.0",
    "@aws-sdk/client-dynamodb": "3.1118.0",
    "@aws-sdk/client-sts": "3.1118.0",
    "@bifravst/from-env": "4.0.0",
    "@bifravst/timestream-helpers": "7.0.0",
    "@middy/core": "7.8.0",
    "@sinclair/typebox": "0.34.52",
    "cfn-response": "1.0.1",
    "e118-iin-list": "4.5.1",
    "lodash-es": "4.18.1"
  }
}
